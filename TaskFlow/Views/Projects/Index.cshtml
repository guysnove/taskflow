@model List<ProjectSummary>
@{
    ViewData["Title"] = "Projects";
}

<h1>Projects</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<p><a asp-action="Create" class="btn btn-primary btn-sm">Add a project</a></p>

@if (Model.Count == 0)
{
    <p>No projects yet. A project groups related tasks, like "Office move".</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Project</th><th>Tasks</th><th>Still to do</th></tr>
        </thead>
        <tbody>
            @foreach (var project in Model)
            {
                <tr>
                    <td>
                        <a asp-route="ProjectDetails" asp-route-id="@project.Id">@project.Name</a>
                        @if (!string.IsNullOrWhiteSpace(project.Description))
                        {
                            <div class="small text-muted">@project.Description</div>
                        }
                    </td>
                    <td>@project.Tasks</td>
                    <td>@project.Open</td>
                </tr>
            }
        </tbody>
    </table>
}
