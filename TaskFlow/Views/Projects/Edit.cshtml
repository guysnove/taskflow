@model ProjectInput
@{
    int id = (int)ViewData["Id"]!;
    ViewData["Title"] = "Edit project";
}

<h1>Edit project</h1>

<div asp-validation-summary="All" class="alert alert-danger validation-summary"></div>

<form asp-action="Edit" asp-route-id="@id" method="post" class="task-form" novalidate>
    <partial name="_ProjectFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-route="ProjectDetails" asp-route-id="@id" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
