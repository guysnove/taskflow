@model bool
@{
    ViewData["Title"] = "Notification settings";
}

<h1>Notification settings</h1>
<p>You always see notifications here in TaskFlow. You can also get each one by email.</p>

<form asp-action="Settings" method="post">
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="emailNotifications" name="emailNotifications" value="true" checked="@Model">
        <label class="form-check-label" for="emailNotifications">Also email me each notification</label>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Save</button>
</form>
