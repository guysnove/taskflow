@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h1>Notifications</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<p class="small">
    <a asp-action="Settings">Settings</a>
</p>

@if (Model.Count == 0)
{
    <p>No notifications yet.</p>
}
else
{
    <form asp-action="MarkAllRead" method="post" class="mb-2">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Mark all as read</button>
    </form>
    <ul class="list-group notification-list">
        @foreach (var n in Model)
        {
            <li class="list-group-item @(n.ReadAt is null ? "fw-semibold" : "text-muted")">
                @if (n.ReadAt is null) { <span class="badge bg-primary me-1">new</span> }
                @if (n.Link is not null) { <a href="@n.Link">@n.Text</a> } else { @n.Text }
                <span class="small text-muted ms-2">@n.CreatedAt.ToString("d MMM HH:mm")</span>
            </li>
        }
    </ul>
}
