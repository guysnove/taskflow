@model TaskItem
@inject TimeProvider Time
@{
    ViewData["Title"] = Model.Title;
    var today = Time.Today();
}

<h1>@Model.Title</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<dl class="row">
    <dt class="col-sm-2">Priority</dt>
    <dd class="col-sm-10"><priority value="@Model.Priority" /></dd>

    <dt class="col-sm-2">Due</dt>
    <dd class="col-sm-10">@(Model.Due?.ToString("dddd d MMMM yyyy") ?? "No due date")</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">
        <partial name="_StatusBadge" model="Model" />
        @if (!Model.Done && !Model.IsOverdue(today))
        {
            <span>To do</span>
        }
    </dd>

    <dt class="col-sm-2">Project</dt>
    <dd class="col-sm-10">
        @if (Model.Project is not null)
        {
            <a asp-route="ProjectDetails" asp-route-id="@Model.Project.Id">@Model.Project.Name</a>
        }
        else
        {
            <span>—</span>
        }
    </dd>

    <dt class="col-sm-2">Notes</dt>
    <dd class="col-sm-10">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>
    <dt class="col-sm-2">Added</dt>
    <dd class="col-sm-10">@(Model.CreatedOn?.ToString("ddd d MMM yyyy") ?? "before this was recorded")</dd>
</dl>

@* Chapter 30: the full path, because StepsController shows this view too: "_Steps" alone is searched in Views/Steps. *@
<partial name="~/Views/Tasks/_Steps.cshtml" model="Model" />

@* Chapter 30: asp-controller="Tasks", because StepsController shows this view too (when a step is invalid). *@
<p>
    <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Edit</a>
    <a asp-controller="Tasks" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Delete</a>
    <a asp-controller="Tasks" asp-action="Index" class="btn btn-link btn-sm">Back to my tasks</a>
</p>
