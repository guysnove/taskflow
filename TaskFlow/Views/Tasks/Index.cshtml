@model List<TaskItem>
@using TaskFlow.Services
@{
    ViewData["Title"] = "My tasks";
    int left = (int)ViewData["Left"]!;         // Course 2, Chapter 26: of ALL matching tasks, not only this page
    int total = (int)ViewData["Total"]!;
    int pageNumber = (int)ViewData["Page"]!, pages = (int)ViewData["Pages"]!;
    var stepCounts = (Dictionary<int, StepCount>)ViewData["StepCounts"]!;
    string show = (string)ViewData["Show"]!;   // "all", "open" or "overdue"
    string sort = (string)ViewData["Sort"]!;   // "due", "priority" or "title"
    var today = (DateOnly)ViewData["Today"]!;  // Course 2, Chapter 19: for the effective priority
    int? project = (int?)ViewData["Project"];  // only this project's tasks, or null for all
    string? q = (string?)ViewData["Q"];         // the search words, or null (Course 2, Chapter 3)
}

<h1>My tasks</h1>
<p><a asp-action="Quick">Quick list</a> (the same tasks, through the API)</p>

@if (project is not null)
{
    <p>Showing one project's tasks. <a asp-action="Index">Show all tasks</a></p>
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<p>
    @left of @total tasks still to do.
    <a asp-action="Create" class="btn btn-primary btn-sm ms-2">Add a task</a>
</p>

<form method="get" asp-action="Index" class="row g-2 align-items-center mb-2" role="search">
    <div class="col-auto">
        <label for="q" class="visually-hidden">Search tasks</label>
        <input id="q" name="q" value="@q" class="form-control form-control-sm" placeholder="Search titles, e.g. login bug">
    </div>
    <input type="hidden" name="show" value="@(show == "all" ? null : show)" disabled="@(show == "all")">
    <input type="hidden" name="sort" value="@sort">
    <div class="col-auto"><button type="submit" class="btn btn-outline-secondary btn-sm">Search</button></div>
    @if (q is not null)
    {
        <div class="col-auto small"><a asp-action="Index" asp-route-show="@show" asp-route-sort="@sort">Clear search</a></div>
    }
</form>

<nav aria-label="Filter and sort" class="small mb-2">
    Show:
    <a asp-action="Index" asp-route-sort="@sort" asp-route-q="@q"
       aria-current="@(show == "all" ? "true" : null)">all</a> ·
    <a asp-action="Index" asp-route-show="open" asp-route-sort="@sort" asp-route-q="@q"
       aria-current="@(show == "open" ? "true" : null)">still to do</a> ·
    <a asp-action="Index" asp-route-show="overdue" asp-route-sort="@sort" asp-route-q="@q"
       aria-current="@(show == "overdue" ? "true" : null)">overdue</a>
    <span class="mx-2">|</span>
    Sort by:
    <a asp-action="Index" asp-route-show="@show" asp-route-sort="due" asp-route-q="@q"
       aria-current="@(sort == "due" ? "true" : null)">due date</a> ·
    <a asp-action="Index" asp-route-show="@show" asp-route-sort="priority" asp-route-q="@q"
       aria-current="@(sort == "priority" ? "true" : null)">priority</a> ·
    <a asp-action="Index" asp-route-show="@show" asp-route-sort="title" asp-route-q="@q"
       aria-current="@(sort == "title" ? "true" : null)">title</a>
</nav>

@if (Model.Count == 0)
{
    @if (q is not null)
    {
        <p>No tasks match “@q”.</p>
    }
    else
    {
        <p>No tasks yet. Add your first one!</p>
    }
}
else
{
    <table class="table align-middle task-table">
        <thead>
            <tr><th>Task</th><th>Project</th><th>Priority</th><th>Due</th><th><span class="visually-hidden">Actions</span></th></tr>
        </thead>
        <tbody>
            @foreach (var task in Model)
            {
                <tr class="@(task.Done ? "task-done" : "")">
                    <td data-label="Task">
                        <a asp-action="Details" asp-route-id="@task.Id">@task.Title</a>
                        @if (stepCounts.TryGetValue(task.Id, out var steps))
                        {
                            string progress = steps.Progress;
                            <div class="small text-muted">@progress</div>    @* Chapter 30 *@
                        }
                    </td>
                    <td data-label="Project">
                        @if (task.Project is not null)
                        {
                            <a asp-action="Index" asp-route-project="@task.ProjectId">@task.Project.Name</a>
                        }
                    </td>
                    <td data-label="Priority"><priority value="@task.Priority" effective="@PriorityRules.For(task, today)" /></td>
                    <td data-label="Due">
                        @(task.Due?.ToString("ddd d MMM") ?? "—")
                        <partial name="_StatusBadge" model="task" />
                    </td>
                    <td>
                        @if (!task.Done)
                        {
                            <form asp-action="Done" asp-route-id="@task.Id" method="post">
                                <button type="submit" class="btn btn-outline-success btn-sm">Done</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (pages > 1)
    {
        <nav aria-label="Pages" class="small">
            Page @pageNumber of @pages (@total tasks).
            @if (pageNumber > 1)
            {
                <a asp-action="Index" asp-route-show="@(show == "all" ? null : show)" asp-route-sort="@sort" asp-route-project="@project" asp-route-q="@q" asp-route-page="@(pageNumber - 1)">← Previous</a>
            }
            @if (pageNumber < pages)
            {
                <a asp-action="Index" asp-route-show="@(show == "all" ? null : show)" asp-route-sort="@sort" asp-route-project="@project" asp-route-q="@q" asp-route-page="@(pageNumber + 1)">Next →</a>
            }
        </nav>
    }
}
