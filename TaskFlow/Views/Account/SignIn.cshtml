@model SignInInput
@{
    ViewData["Title"] = "Sign in";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<h1>Sign in</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<div asp-validation-summary="All" class="alert alert-danger validation-summary"></div>

<form asp-action="SignIn" asp-route-returnUrl="@returnUrl" method="post" class="task-form" novalidate>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username">
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password">
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="RememberMe" class="form-check-input">
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
    <a asp-action="Register" class="btn btn-link">Create an account</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
