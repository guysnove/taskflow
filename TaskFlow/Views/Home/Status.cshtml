@{
    int code = (int)ViewData["Code"]!;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}

@if (code == 404)
{
    <h1>Page not found</h1>
    <p>Sorry, there's nothing at this address. It may have moved, or there may be a typo.</p>
}
else
{
    <h1>Something went wrong</h1>
    <p>The server answered with status code @code.</p>
}

<p>
    <a asp-controller="Tasks" asp-action="Index">Go to my tasks</a> or
    <a asp-controller="Home" asp-action="Index">the home page</a>.
</p>
