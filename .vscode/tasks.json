{
  // Course 2, Chapter 17: run TaskFlow's tests from VS Code, with no extension.
  //   Ctrl+Shift+P → "Tasks: Run Test Task" runs the default test task;
  //   Terminal > Run Task… lists them all.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "args": ["build", "-warnaserror"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: unit",
      "command": "dotnet",
      "args": ["test", "TaskFlow.Tests", "--filter", "FullyQualifiedName~TaskFlow.Tests.Unit"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: all (no browser)",
      "command": "dotnet",
      "args": ["test", "--filter", "Category!=Growth&Category!=E2E"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      // Course 2, Chapter 18: needs Chromium. Set TASKFLOW_BROWSER to a Chrome/Chromium, or once:
      //   pwsh TaskFlow.Tests/bin/Debug/net10.0/playwright.ps1 install chromium
      "label": "test: end-to-end (a real browser)",
      "command": "dotnet",
      "args": ["test", "TaskFlow.Tests", "--filter", "Category=E2E", "--logger", "console;verbosity=normal"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: coverage of the business logic",
      "command": "./tools/coverage.sh",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
